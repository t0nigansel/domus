# Copy to .env and adjust. .env is ignored by Git - never commit real secrets.

# --- API server -------------------------------------------------------------
# PORT=3001
# Loopback only by default. Don't use 0.0.0.0 on untrusted networks.
# HOST=127.0.0.1
# Browser origins allowed to call the API (comma-separated, no trailing slash)
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Accepted Host headers (blocks DNS rebinding)
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Storage (until the PostgreSQL migration in phase 1) --------------------
# DOMUS_DB_FILE=./server/db.json
# DOMUS_FILES_DIR=./data/files
# DOMUS_RAW_DIR=./rohdaten

# --- PostgreSQL (docker compose, used from phase 1) -------------------------
# Local development credentials only.
POSTGRES_USER=domus
POSTGRES_PASSWORD=domus-dev-only
POSTGRES_DB=domus
DATABASE_URL=postgres://domus:domus-dev-only@localhost:5432/domus

# --- Frontend (Vite) ----------------------------------------------------------
# Where the Vite dev/preview server forwards /api
# DOMUS_API_URL=http://localhost:3001
