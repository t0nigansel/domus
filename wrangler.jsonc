{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domus-preview",
  "account_id": "f218aabec74d3c0817a632fe07cbb3d5",
  "main": "server/cloud/worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloud",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/api-docs", "/api-docs/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "DOMUS_ENV": "preview",
    "BETTER_AUTH_URL": "https://domus-preview.toni-gansel.workers.dev"
  },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "domus-preview-files", "jurisdiction": "eu" }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5eca7963027f4c258cb9b9a60a25fa58",
      "localConnectionString": "postgres://domus:domus-dev-only@127.0.0.1:5432/domus"
    }
  ],
  "env": {
    "preview": {
      "name": "domus-preview",
      "vars": {
        "DOMUS_ENV": "preview",
        "BETTER_AUTH_URL": "https://domus-preview.toni-gansel.workers.dev"
      },
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "domus-preview-files", "jurisdiction": "eu" }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "5eca7963027f4c258cb9b9a60a25fa58",
          "localConnectionString": "postgres://domus:domus-dev-only@127.0.0.1:5432/domus"
        }
      ]
    },
    "production": {
      "name": "domus",
      "vars": {
        "DOMUS_ENV": "production",
        "BETTER_AUTH_URL": "https://domus.toni-gansel.workers.dev"
      },
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "domus-files", "jurisdiction": "eu" }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "b9c1a073416646c0ac8929022803bce9",
          "localConnectionString": "postgres://domus:domus-dev-only@127.0.0.1:5432/domus"
        }
      ]
    }
  }
}
