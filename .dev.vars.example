# Copy to .dev.vars for Wrangler local development. Never commit real secrets.
# DATABASE_URL=postgres://domus:domus-dev-only@localhost:5432/domus
# BETTER_AUTH_URL=http://localhost:8787
# BETTER_AUTH_SECRET=<generate at least 32 random characters>
# PILOT_EMAILS=<comma-separated invited email addresses>
# MAIL_FROM=no-reply@faktio.net
# EMAIL is provided by the Cloudflare binding. Local delivery is simulated.
# RESEND_API_KEY=<optional fallback provider key when EMAIL is absent>
